{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://3dcard-builder-production.up.railway.app/api"
  },
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://3dcard-builder-production.up.railway.app/api"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
